    Сообщить("Загрузка материалов успешно завершена.");
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьМатериалыНаСервере(ТабДОк, ПутьКФайлу)
    ТабДОк.Прочитать(ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Значение);
    
    // Загружаем данные из Excel
    ПостроительЗапроса = Новый ПостроительЗапроса;
    ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабДОк.Область("Materials_import"));
    ПостроительЗапроса.Выполнить();
    ТаблицаМатериалов = ПостроительЗапроса.Результат.Выгрузить();
    
    КоличествоЗагруженных = 0;
    КоличествоОшибок = 0;
    КоличествоНеНайдено = 0;
    
    Для каждого СтрокаМатериал Из ТаблицаМатериалов Цикл
        // Получаем наименование материала
        НаименованиеМатериала = СокрЛП(СтрокаМатериал.НаименованиеМатериала);
        
        Если НЕ ПустаяСтрока(НаименованиеМатериала) Тогда
            
            // Проверяем, существует ли такой материал в справочнике
            СуществующийМатериал = Справочники.Материалы.НайтиПоНаименованию(НаименованиеМатериала);
            
            Если СуществующийМатериал = Справочники.Материалы.ПустаяСсылка() Тогда
                НовыйМатериал = Справочники.Материалы.СоздатьЭлемент();
            Иначе
                НовыйМатериал = СуществующийМатериал;
            КонецЕсли;
            
            // 1. Заполняем наименование
            НовыйМатериал.Наименование = НаименованиеМатериала;
            
            // 2. Заполняем тип материала (из справочника ТипыМатериалов)
            НаименованиеТипа = СокрЛП(СтрокаМатериал.ТипМатериала);
            Если НЕ ПустаяСтрока(НаименованиеТипа) Тогда
                ТипМатериала = Справочники.ТипыМатериалов.НайтиПоНаименованию(НаименованиеТипа);
                Если ТипМатериала <> Справочники.ТипыМатериалов.ПустаяСсылка() Тогда
                    НовыйМатериал.ТипМатериала = ТипМатериала;
                Иначе
                    Сообщить("Тип материала '" + НаименованиеТипа + "' не найден в справочнике ТипыМатериалов для материала '" + НаименованиеМатериала + "'");
                    КоличествоНеНайдено = КоличествоНеНайдено + 1;
                КонецЕсли;
            КонецЕсли;
            
            // 3. Заполняем цену
            Цена = СтрокаМатериал.ЦенаЕдиницыМатериала;
            Если ТипЗнч(Цена) = Тип("Число") Тогда
                НовыйМатериал.Цена = Цена;
            Иначе
                Попытка
                    СтрокаЦена = Строка(Цена);
                    СтрокаЦена = СтрЗаменить(СтрокаЦена, ".", ",");
                    НовыйМатериал.Цена = Число(СтрокаЦена);
                Исключение
                    НовыйМатериал.Цена = 0;
                    Сообщить("Ошибка преобразования цены для материала: " + НаименованиеМатериала);
                КонецПопытки;
            КонецЕсли;
            
            // 4. Заполняем количество на складе
            КоличествоНаСкладе = СтрокаМатериал.КоличествоНаСкладе;
            Если ТипЗнч(КоличествоНаСкладе) = Тип("Число") Тогда
                НовыйМатериал.КоличествоНаСкладе = КоличествоНаСкладе;
            Иначе
                Попытка
                    СтрокаКоличество = Строка(КоличествоНаСкладе);
                    СтрокаКоличество = СтрЗаменить(СтрокаКоличество, ".", ",");
                    НовыйМатериал.КоличествоНаСкладе = Число(СтрокаКоличество);
                Исключение
                    НовыйМатериал.КоличествоНаСкладе = 0;
                КонецПопытки;
            КонецЕсли;
            
            // 5. Заполняем минимальное количество
            МинимальноеКоличество = СтрокаМатериал.МинимальноеКоличество;
            Если ТипЗнч(МинимальноеКоличество) = Тип("Число") Тогда
                НовыйМатериал.МинимальноеКоличество = МинимальноеКоличество;
            Иначе
                Попытка
                    СтрокаМинКол = Строка(МинимальноеКоличество);
                    СтрокаМинКол = СтрЗаменить(СтрокаМинКол, ".", ",");
                    НовыйМатериал.МинимальноеКоличество = Число(СтрокаМинКол);
                Исключение
                    НовыйМатериал.МинимальноеКоличество = 0;
                КонецПопытки;
            КонецЕсли;
            
            // 6. Заполняем количество в упаковке
            КоличествоВУпаковке = СтрокаМатериал.КоличествоВУпаковке;
            Если ТипЗнч(КоличествоВУпаковке) = Тип("Число") Тогда
                НовыйМатериал.КоличествоВУпаковке = КоличествоВУпаковке;
            Иначе
                Попытка
                    СтрокаКолУпак = Строка(КоличествоВУпаковке);
                    СтрокаКолУпак = СтрЗаменить(СтрокаКолУпак, ".", ",");
                    НовыйМатериал.КоличествоВУпаковке = Число(СтрокаКолУпак);
                Исключение
                    НовыйМатериал.КоличествоВУпаковке = 0;
                КонецПопытки;
            КонецЕсли;
            
            // 7. Заполняем единицу измерения (перечисление)
            НаименованиеЕдиницы = СокрЛП(СтрокаМатериал.ЕдиницаИзмерения);
            Если НЕ ПустаяСтрока(НаименованиеЕдиницы) Тогда
                              ПолноеНаименование = "";
                Если НаименованиеЕдиницы = "рул" Тогда
                    ПолноеНаименование = "Рул";
                ИначеЕсли НаименованиеЕдиницы = "кг" Тогда
                    ПолноеНаименование = "Кг";
                ИначеЕсли НаименованиеЕдиницы = "л" Тогда
                    ПолноеНаименование = "Л";
                Иначе
                    ПолноеНаименование = НаименованиеЕдиницы;
                КонецЕсли;
                
                Попытка
                    ЕдиницаИзмерения = Перечисления.ЕдиницыИзмерения[ПолноеНаименование];
                    Если ЕдиницаИзмерения <> Неопределено Тогда
                        НовыйМатериал.ЕдиницаИзмерения = ЕдиницаИзмерения;
                    Иначе
                        Сообщить("Единица измерения '" + НаименованиеЕдиницы + "' не найдена в перечислении для материала '" + НаименованиеМатериала + "'");
                    КонецЕсли;
                Исключение
                    Сообщить("Ошибка при установке единицы измерения для материала: " + НаименованиеМатериала);
                КонецПопытки;
            КонецЕсли;
            
            // Записываем материал
            Попытка
                НовыйМатериал.Записать();
                КоличествоЗагруженных = КоличествоЗагруженных + 1;
                Сообщить("Материал '" + НаименованиеМатериала + "' успешно загружен.");
            Исключение
                КоличествоОшибок = КоличествоОшибок + 1;
                Сообщить("Ошибка при загрузке материала '" + НаименованиеМатериала + "': " + ИнформацияОбОшибке().Описание);
            КонецПопытки;
            
        КонецЕсли;
    КонецЦикла;
    
    Сообщить("Загрузка материалов завершена.");
    Сообщить("Загружено: " + КоличествоЗагруженных);
    Сообщить("Ошибок: " + КоличествоОшибок);
    Сообщить("Не найдено типов/единиц: " + КоличествоНеНайдено);
    
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСпецификациюПродукции(Команда)
    Если ПустаяСтрока(ПутькФайлу) Тогда
        Сообщить("Не выбран файл для загрузки. Выберите файл с помощью кнопки выбора.");
        Возврат;
    КонецЕсли;
    
    ТабДОк = Новый ТабличныйДокумент;
    ЗагрузитьСпецификациюПродукцииНаСервере(ТабДОк, ПутькФайлу);
    Сообщить("Загрузка спецификации продукции успешно завершена.");
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСпецификациюПродукцииНаСервере(ТабДОк, ПутьКФайлу)
    ТабДОк.Прочитать(ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Значение);
    
    // Загружаем данные из Excel
    ПостроительЗапроса = Новый ПостроительЗапроса;
    ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабДОк.Область("Product_materials_import"));
    ПостроительЗапроса.Выполнить();
    ТаблицаСпецификации = ПостроительЗапроса.Результат.Выгрузить();
    
    КоличествоЗагруженных = 0;
    КоличествоОшибок = 0;
    КоличествоНеНайдено = 0;
    
    // Для группировки данных по продукции
    СоответствиеПродукций = Новый Соответствие;
    
    // Сначала группируем данные по продукции
    Для каждого СтрокаСпецификация Из ТаблицаСпецификации Цикл
        НаименованиеПродукции = СокрЛП(СтрокаСпецификация.Продукция);
        НаименованиеМатериала = СокрЛП(СтрокаСпецификация.НаименованиеМатериала);
        
        Если НЕ ПустаяСтрока(НаименованиеПродукции) И НЕ ПустаяСтрока(НаименованиеМатериала) Тогда
            Ключ = НаименованиеПродукции;
            
            // Проверяем наличие ключа
            МассивМатериалов = СоответствиеПродукций.Получить(Ключ);
            Если МассивМатериалов = Неопределено Тогда
                МассивМатериалов = Новый Массив;
                СоответствиеПродукций.Вставить(Ключ, МассивМатериалов);
            КонецЕсли;
            
            ДанныеСтроки = Новый Структура("НаименованиеМатериала, НеобходимоеКоличество", 
                НаименованиеМатериала, 
                СтрокаСпецификация.НеобходимоеКоличествоМатериала);
            
            МассивМатериалов.Добавить(ДанныеСтроки);
        КонецЕсли;
    КонецЦикла;
    
    // Обрабатываем каждую продукцию
    Для каждого ЭлементСоответствия Из СоответствиеПродукций Цикл
        НаименованиеПродукции = ЭлементСоответствия.Ключ;
        МассивМатериалов = ЭлементСоответствия.Значение;
        
        // Ищем продукцию в справочнике
        Продукт = Справочники.Продукция.НайтиПоНаименованию(НаименованиеПродукции);
        
        Если Продукт = Справочники.Продукция.ПустаяСсылка() Тогда
            КоличествоНеНайдено = КоличествоНеНайдено + 1;
            Сообщить("Продукция не найдена: " + НаименованиеПродукции);
            Продолжить;
        КонецЕсли;
        
        // Получаем объект продукции для изменения
        ОбъектПродукт = Продукт.ПолучитьОбъект();
        
        Если ОбъектПродукт = Неопределено Тогда
            КоличествоОшибок = КоличествоОшибок + 1;
            Сообщить("Не удалось получить объект продукции: " + НаименованиеПродукции);
            Продолжить;
        КонецЕсли;
        
        // Очищаем текущую табличную часть спецификации
        ОбъектПродукт.СпецификацияПродукции.Очистить();
        
        // Заполняем табличную часть
        Для каждого ДанныеМатериала Из МассивМатериалов Цикл
            НаименованиеМатериала = ДанныеМатериала.НаименованиеМатериала;
            ТребуемоеКоличество = ДанныеМатериала.НеобходимоеКоличество;
            
            // Ищем материал в справочнике материалов
            Материал = Справочники.Материалы.НайтиПоНаименованию(НаименованиеМатериала);
            
            Если Материал = Справочники.Материалы.ПустаяСсылка() Тогда
                КоличествоНеНайдено = КоличествоНеНайдено + 1;
                Сообщить("Материал не найден: " + НаименованиеМатериала + " для продукции " + НаименованиеПродукции);
                Продолжить;
            КонецЕсли;
            
            // Преобразуем количество в число
            ЧислоКоличество = ПреобразоватьВЧисло(ТребуемоеКоличество);
            Если ЧислоКоличество = 0 И ТребуемоеКоличество <> 0 Тогда
                Сообщить("Ошибка преобразования количества для продукции '" + НаименованиеПродукции + "' и материала '" + НаименованиеМатериала + "'");
                Продолжить;
            КонецЕсли;
            
            // Добавляем строку в табличную часть
            НоваяСтрока = ОбъектПродукт.СпецификацияПродукции.Добавить();
            НоваяСтрока.Продукт = Продукт;
            НоваяСтрока.Материал = Материал;
            НоваяСтрока.ТребуемоеКоличество = ЧислоКоличество;
            
        КонецЦикла;
        
        // Записываем объект продукции
        Попытка
            ОбъектПродукт.Записать();
            КоличествоЗагруженных = КоличествоЗагруженных + 1;
            Сообщить("Загружена спецификация для продукции: " + НаименованиеПродукции + " (строк: " + ОбъектПродукт.СпецификацияПродукции.Количество() + ")");
        Исключение
            КоличествоОшибок = КоличествоОшибок + 1;
            Сообщить("Ошибка при записи продукции " + НаименованиеПродукции + ": " + ИнформацияОбОшибке().Описание);
        КонецПопытки;
        
    КонецЦикла;
    
    Сообщить("Загрузка спецификации продукции завершена.");
    Сообщить("Загружено продукции: " + КоличествоЗагруженных);
    Сообщить("Ошибок: " + КоличествоОшибок);
    Сообщить("Не найдено элементов (продукция/материалы): " + КоличествоНеНайдено);
    
КонецПроцедуры

&НаСервере
Функция ПреобразоватьВЧисло(Значение)
    Если ТипЗнч(Значение) = Тип("Число") Тогда
        Возврат Значение;
    Иначе
        Попытка
            СтрокаКоличество = Строка(Значение);
            СтрокаКоличество = СтрЗаменить(СтрокаКоличество, ",", ".");
            СтрокаКоличество = СтрЗаменить(СтрокаКоличество, " ", "");
            Возврат Число(СтрокаКоличество);
        Исключение
            Возврат 0;
        КонецПопытки;
    КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
КонецПроцедуры