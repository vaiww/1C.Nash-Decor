&НаСервере
Процедура ЗагрузитьТипыПродукцииНаСервере(ТабДОк, ПутьКФайлу)
    ТабДОк.Прочитать(ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Значение);
    
    // Загружаем данные из Excel
    ПостроительЗапроса = Новый ПостроительЗапроса;
    ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабДОк.Область("Product_type_import"));
    ПостроительЗапроса.Выполнить();
    ТаблицаТипов = ПостроительЗапроса.Результат.Выгрузить();
    
    КоличествоЗагруженных = 0;
    КоличествоОшибок = 0;
    
    Для каждого СтрокаТип Из ТаблицаТипов Цикл
        // Получаем наименование типа продукции
        НаименованиеТипа = СокрЛП(СтрокаТип.ТипПродукции);
        
        Если НЕ ПустаяСтрока(НаименованиеТипа) Тогда
            
            // Проверяем, существует ли такой тип в справочнике
            СуществующийТип = Справочники.ТипыПродукции.НайтиПоНаименованию(НаименованиеТипа);
            
            Если СуществующийТип = Справочники.ТипыПродукции.ПустаяСсылка() Тогда
                НовыйТип = Справочники.ТипыПродукции.СоздатьЭлемент();
                НовыйТип.Наименование = НаименованиеТипа;
                
                // Пробуем заполнить коэффициент (если реквизит существует)
                ЗначениеКоэффициента = СтрокаТип.КоэффициентТипаПродукции;
                
                Попытка
                    НовыйТип.Коэффициент = ЗначениеКоэффициента;
                Исключение
                    // Если реквизита нет, пропускаем
                КонецПопытки;
                
                Попытка
                    НовыйТип.Записать();
                    КоличествоЗагруженных = КоличествоЗагруженных + 1;
                    Сообщить("Тип продукции '" + НаименованиеТипа + "' успешно загружен.");
                Исключение
                    КоличествоОшибок = КоличествоОшибок + 1;
                    Сообщить("Ошибка при загрузке типа продукции '" + НаименованиеТипа + "': " + ИнформацияОбОшибке().Описание);
                КонецПопытки;
            Иначе
                КоличествоЗагруженных = КоличествоЗагруженных + 1;
                Сообщить("Тип продукции '" + НаименованиеТипа + "' уже существует в справочнике.");
            КонецЕсли;
            
        КонецЕсли;
    КонецЦикла;
    
    Сообщить("Загрузка типов продукции завершена. Загружено: " + КоличествоЗагруженных + ", ошибок: " + КоличествоОшибок);
    
КонецПроцедуры

