&НаСервере
Процедура ЗагрузитьТипыМатериаловНаСервере(ТабДОк, ПутьКФайлу)
    ТабДОк.Прочитать(ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Значение);
    
    // Загружаем данные из Excel
    ПостроительЗапроса = Новый ПостроительЗапроса;
    ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабДОк.Область("Material_type_import"));
    ПостроительЗапроса.Выполнить();
    ТаблицаТипов = ПостроительЗапроса.Результат.Выгрузить();
    
    КоличествоЗагруженных = 0;
    КоличествоОшибок = 0;
    
    Для каждого СтрокаТип Из ТаблицаТипов Цикл
        // Получаем наименование типа материала
        НаименованиеТипа = СокрЛП(СтрокаТип.ТипМатериала);
        
        Если НЕ ПустаяСтрока(НаименованиеТипа) Тогда
            
            // Проверяем, существует ли такой тип в справочнике
            СуществующийТип = Справочники.ТипыМатериалов.НайтиПоНаименованию(НаименованиеТипа);
            
            Если СуществующийТип = Справочники.ТипыМатериалов.ПустаяСсылка() Тогда
                НовыйТип = Справочники.ТипыМатериалов.СоздатьЭлемент();
                НовыйТип.Наименование = НаименованиеТипа;
            Иначе
                НовыйТип = СуществующийТип;
            КонецЕсли;
            
            // Заполняем процент брака
            ЗначениеПроцента = СтрокаТип.ПроцентБракаМатериала;
            
            // Преобразуем в число
            Если ТипЗнч(ЗначениеПроцента) = Тип("Число") Тогда
                НовыйТип.ПроцентБрака = ЗначениеПроцента;
            Иначе
                // Преобразуем строку в число (заменяем точку на запятую)
                Попытка
                    СтрокаПроцент = Строка(ЗначениеПроцента);
                    СтрокаПроцент = СтрЗаменить(СтрокаПроцент, ".", ",");
                    НовыйТип.ПроцентБрака = Число(СтрокаПроцент);
                Исключение
                    НовыйТип.ПроцентБрака = 0;
                    Сообщить("Ошибка преобразования процента брака для типа '" + НаименованиеТипа + "'. Значение: " + ЗначениеПроцента);
                КонецПопытки;
            КонецЕсли;
            
            // Записываем тип материала
            Попытка
                НовыйТип.Записать();
                КоличествоЗагруженных = КоличествоЗагруженных + 1;
                Сообщить("Тип материала '" + НаименованиеТипа + "' успешно загружен. Процент брака: " + НовыйТип.ПроцентБрака);
            Исключение
                КоличествоОшибок = КоличествоОшибок + 1;
                Сообщить("Ошибка при загрузке типа материала '" + НаименованиеТипа + "': " + ИнформацияОбОшибке().Описание);
            КонецПопытки;
            
        КонецЕсли;
    КонецЦикла;
    
    Сообщить("Загрузка типов материалов завершена. Загружено: " + КоличествоЗагруженных + ", ошибок: " + КоличествоОшибок);
    
КонецПроцедуры
