&НаКлиенте
Процедура ВыбратьФайлНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
    Попытка
        Оповещение = Новый ОписаниеОповещения("ОбработкаФайла", ЭтотОбъект);
        НачатьПомещениеФайлаНаСервер(Оповещение, , , , , УникальныйИдентификатор);
    Исключение
        Сообщить("К файлу нет доступа. Возможно он открыт в другом приложении.");
        ПутькФайлу = "";
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаФайла(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
    Если ОписаниеПомещенногоФайла = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ПутькФайлу = ОписаниеПомещенногоФайла.СсылкаНаФайл.Файл.ПолноеИмя;
    Сообщить("Выбран файл: " + ПутькФайлу);
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПродукциюНаСервере(ТабДОк, ПутьКФайлу)
    ТабДОк.Прочитать(ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Значение);
    
    ПостроительЗапроса = Новый ПостроительЗапроса;
    ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабДОк.Область("Products_import"));
    ПостроительЗапроса.Выполнить();
    ТаблицаПродукции = ПостроительЗапроса.Результат.Выгрузить();
    
    КоличествоЗагруженных = 0;
    КоличествоОшибок = 0;
    
    Для каждого СтрокаПродукция Из ТаблицаПродукции Цикл
        Артикул = СокрЛП(СтрокаПродукция.Артикул);
        
        Если НЕ ПустаяСтрока(Артикул) Тогда
            
            // Получаем тип продукции из уже заполненного справочника
            НаименованиеТипа = СокрЛП(СтрокаПродукция.ТипПродукции);
            СсылкаНаТип = Справочники.ТипыПродукции.ПустаяСсылка();
            
            Если НЕ ПустаяСтрока(НаименованиеТипа) Тогда
                СсылкаНаТип = Справочники.ТипыПродукции.НайтиПоНаименованию(НаименованиеТипа);
                
                // Если тип не найден в справочнике - выводим предупреждение и пропускаем
                Если СсылкаНаТип = Справочники.ТипыПродукции.ПустаяСсылка() Тогда
                    Сообщить("Тип продукции '" + НаименованиеТипа + "' не найден в справочнике. Продукция с артикулом " + Артикул + " не будет загружена.");
                    Продолжить;
                КонецЕсли;
            КонецЕсли;
            
            // Проверяем, существует ли продукция с таким артикулом
            СуществующаяПродукция = Справочники.Продукция.НайтиПоКоду(Артикул);
            
            Если СуществующаяПродукция = Справочники.Продукция.ПустаяСсылка() Тогда
                НоваяПродукция = Справочники.Продукция.СоздатьЭлемент();
            Иначе
                НоваяПродукция = СуществующаяПродукция;
            КонецЕсли;
            
            // Заполняем реквизиты
            НоваяПродукция.Код = Артикул;
            НоваяПродукция.Артикул = Артикул;
            
            Наименование = СокрЛП(СтрокаПродукция.НаименованиеПродукции);
            Если НЕ ПустаяСтрока(Наименование) Тогда
                НоваяПродукция.Наименование = Наименование;
            КонецЕсли;
            
            // Тип продукции (ссылка на справочник)
            Если СсылкаНаТип <> Справочники.ТипыПродукции.ПустаяСсылка() Тогда
                НоваяПродукция.ТипПродукции = СсылкаНаТип;
            КонецЕсли;
            
            // Минимальная цена
            МинимальнаяЦена = СтрокаПродукция.МинимальнаяСтоимостьДляПартнера;
            Если ТипЗнч(МинимальнаяЦена) = Тип("Число") Тогда
                НоваяПродукция.МинимальнаяЦена = МинимальнаяЦена;
            Иначе
                Попытка
                    НоваяПродукция.МинимальнаяЦена = Число(МинимальнаяЦена);
                Исключение
                    НоваяПродукция.МинимальнаяЦена = 0;
                КонецПопытки;
            КонецЕсли;
            
            // Ширина
            ШиринаСтрокой = СокрЛП(Строка(СтрокаПродукция.ШиринаРулона));
            ШиринаСтрокой = СтрЗаменить(ШиринаСтрокой, ".", ",");
            
            Попытка
                НоваяПродукция.Ширина = Число(ШиринаСтрокой);
            Исключение
                НоваяПродукция.Ширина = 0;
                Сообщить("Ошибка ширины у артикула " + Артикул + ". Значение: " + ШиринаСтрокой);
            КонецПопытки;
            
            // Записываем продукцию
            Попытка
                НоваяПродукция.Записать();
                КоличествоЗагруженных = КоличествоЗагруженных + 1;
                Сообщить("Продукция с артикулом " + Артикул + " успешно загружена.");
            Исключение
                КоличествоОшибок = КоличествоОшибок + 1;
                Сообщить("Ошибка при загрузке продукции с артикулом " + Артикул + ": " + ИнформацияОбОшибке().Описание);
            КонецПопытки;
            
        КонецЕсли;
    КонецЦикла;
    
    Сообщить("Загрузка продукции завершена. Загружено: " + КоличествоЗагруженных + ", ошибок: " + КоличествоОшибок);
    
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
    Если ПустаяСтрока(ПутькФайлу) Тогда
        Сообщить("Не выбран файл для загрузки. Выберите файл с помощью кнопки выбора.");
        Возврат;
    КонецЕсли;
    
    ТабДОк = Новый ТабличныйДокумент;
        
    // Затем загружаем продукцию
    ЗагрузитьПродукциюНаСервере(ТабДОк, ПутькФайлу);
    
    Сообщить("Импорт данных успешно завершен.");
