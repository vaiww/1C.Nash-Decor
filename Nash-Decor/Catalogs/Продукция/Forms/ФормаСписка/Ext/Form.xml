				<QueryText>ВЫБРАТЬ
    СправочникПродукция.Ссылка,
    СправочникПродукция.ПометкаУдаления,
    СправочникПродукция.Код,
    
    // Основная информация (первая строка)
        ВЫБОР
        КОГДА СправочникПродукция.Артикул = "" ТОГДА СправочникПродукция.Наименование
        ИНАЧЕ СправочникПродукция.Наименование + " | " + СправочникПродукция.Артикул
    КОНЕЦ КАК НаименованиеИАртикул,
   
    СправочникПродукция.Статья КАК Статья,
    СправочникПродукция.Описание КАК Описание,
 
        // Финансовые показатели
    СправочникПродукция.МинимальнаяЦена КАК МинимальнаяЦена,
    СправочникПродукция.Стоимость КАК Стоимость,
    
    // Габариты и вес
    СправочникПродукция.Ширина КАК Ширина,
    СправочникПродукция.ВесоваяСетка КАК ВесоваяСетка,
    СправочникПродукция.ОбщийВес КАК ОбщийВес,
    СправочникПродукция.РазмерУпаковки КАК РазмерУпаковки,
    
    // Производство
    СправочникПродукция.ВремяПроизводства КАК ВремяПроизводства,
    
    // Вспомогательные поля
    СправочникПродукция.Изображение КАК Изображение,
    СправочникПродукция.ТипПродукции КАК ТипПродукции,
    СправочникПродукция.СпецификацияПродукции КАК СпецификацияПродукции,
    СправочникПродукция.Предопределенный КАК Предопределенный,
    СправочникПродукция.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
    
ИЗ
    Справочник.Продукция КАК СправочникПродукция
ГДЕ
    НЕ СправочникПродукция.ПометкаУдаления
    </QueryText>
