Процедура ОбработкаПроведения(Отказ, Режим)

    // Регистр накопления Продажи
    Движения.Продажи.Записывать = Истина;
    
    // Очищаем старые движения
    Движения.Продажи.Очистить();

    Для Каждого ТекСтрокаПродажи Из Продажи Цикл
        
        Движение = Движения.Продажи.Добавить();

        Движение.Период = Дата;
        Движение.Партнер = Партнер;
        
        // Если в регистре есть измерение "Продукция"
        // Движение.Продукция = ТекСтрокаПродажи.Продукция;
        
        Движение.Количество = ТекСтрокаПродажи.Количество;
        Движение.Сумма = СуммаПродажи;

    КонецЦикла;

    // Запись движений
    Движения.Записать();

    // Получение общего количества продаж партнера
    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ
    |  СУММА(ПродажиОбороты.КоличествоОборот) КАК ОбщееКоличество
    |ИЗ
    |  РегистрНакопления.Продажи.Обороты КАК ПродажиОбороты
    |ГДЕ
    |  ПродажиОбороты.Партнер = &Партнер";

    Запрос.УстановитьПараметр("Партнер", Партнер);

    РезультатЗапроса = Запрос.Выполнить().Выгрузить();

    // Обновление скидки партнера
    Если РезультатЗапроса.Количество() > 0 И РезультатЗапроса[0].ОбщееКоличество <> Неопределено Тогда

        ПартнерОбъект = Партнер.ПолучитьОбъект();

        ПартнерОбъект.Скидка =
            ФункцииСервера.РасчетСкидкиПартнера(
                РезультатЗапроса[0].ОбщееКоличество);

        ПартнерОбъект.Записать();

    КонецЕсли;

КонецПроцедуры
Функция СведенияОВнешнейОбработке() Экспорт

    ПараметрыРегистрации = Новый Структура;
    ПараметрыРегистрации.Вставить("Вид", "ПечатнаяФорма");
    
    // Указываем, для каких объектов предназначена печатная форма
    МассивНазначений = Новый Массив;
    МассивНазначений.Добавить("Документ.ИсторияПродаж");
    ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
    
    ПараметрыРегистрации.Вставить("Наименование", "Печатная форма ИсторияПродаж");
    ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
    ПараметрыРегистрации.Вставить("Версия", "1.0");
    
    // Создаем таблицу команд
    ТаблицаКоманд = ПолучитьТаблицуКоманд();
    
    // Добавляем команду печати
    ДобавитьКоманду(ТаблицаКоманд, 
                    "Печатная форма ИсторияПродаж",      // Представление (что видит пользователь)
                    "МояПечатнаяФорма",                  // Идентификатор команды
                    "ВызовСерверногоМетода",             // Использование
                    Истина);                              // Показывать оповещение
    
    ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
    
    Возврат ПараметрыРегистрации;
    
КонецФункции

// Вспомогательная функция для создания таблицы команд
Функция ПолучитьТаблицуКоманд()
    
    Команды = Новый ТаблицаЗначений;
    Команды.Колонки.Добавить("Представление");
    Команды.Колонки.Добавить("Идентификатор");
    Команды.Колонки.Добавить("Использование");
    Команды.Колонки.Добавить("ПоказыватьОповещение");
    Команды.Колонки.Добавить("Модификатор");
    
    Возврат Команды;
    
КонецФункции

// Вспомогательная процедура для добавления команды
Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
    
    НоваяКоманда = ТаблицаКоманд.Добавить();
    НоваяКоманда.Представление = Представление;
    НоваяКоманда.Идентификатор = Идентификатор;
    НоваяКоманда.Использование = Использование;
    НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
    НоваяКоманда.Модификатор = Модификатор;
    
КонецПроцедуры

// Основная функция печати (имя должно совпадать с Идентификатором команды)
Функция МояПечатнаяФорма(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
    
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.ИмяПараметровПечати = "ПараметрыПечати";
    
    // Проходим по всем выбранным документам
    Для каждого ТекущийДокумент Из МассивОбъектов Цикл
        
        // Получаем макет
        Макет = ПолучитьМакет("МояПечатнаяФорма");
        Если Макет = Неопределено Тогда
            Сообщить("Макет 'МояПечатнаяФорма' не найден!");
            Возврат Неопределено;
        КонецЕсли;
        
        // ==================================================
        // 1. ВЫВОДИМ ШАПКУ ДОКУМЕНТА
        // ==================================================
        ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
        Если ОбластьШапка <> Неопределено Тогда
            ОбластьШапка.Параметры.Партнер       = ТекущийДокумент.Партнер;
            ОбластьШапка.Параметры.Заявка        = ТекущийДокумент.Заявка;
            ОбластьШапка.Параметры.СуммаПродажи  = ТекущийДокумент.СуммаПродажи;
            ОбластьШапка.Параметры.СпособОплаты  = ТекущийДокумент.СпособОплаты;
            ОбластьШапка.Параметры.СтатусОплаты  = ТекущийДокумент.СтатусОплаты;
            ОбластьШапка.Параметры.Комментарий   = ТекущийДокумент.Комментарий;
            ТабДок.Вывести(ОбластьШапка);
        КонецЕсли;
        
        // ==================================================
        // 2. ВЫВОДИМ ТАБЛИЧНУЮ ЧАСТЬ "ПРОДАЖИ"
        // ==================================================
        ОбластьСтрокаТЧ = Макет.ПолучитьОбласть("СтрокаТЧ");
        Если ОбластьСтрокаТЧ <> Неопределено Тогда
            
            // Проверяем, есть ли строки в табличной части
            Если ТекущийДокумент.Продажи.Количество() > 0 Тогда
                
                Для каждого СтрокаТЧ Из ТекущийДокумент.Продажи Цикл
                    ОбластьСтрокаТЧ.Параметры.Продукция   = СтрокаТЧ.Продукция;
                    ОбластьСтрокаТЧ.Параметры.Количество  = СтрокаТЧ.Количество;
                    ОбластьСтрокаТЧ.Параметры.ДатаПродажи = СтрокаТЧ.ДатаПродажи;
                    ТабДок.Вывести(ОбластьСтрокаТЧ);
                КонецЦикла;
                
            Иначе
                // Если нет строк, выводим пустую строку с сообщением
                ОбластьСтрокаТЧ.Параметры.Продукция   = "Нет данных";
                ОбластьСтрокаТЧ.Параметры.Количество  = 0;
                ОбластьСтрокаТЧ.Параметры.ДатаПродажи = "";
                ТабДок.Вывести(ОбластьСтрокаТЧ);
            КонецЕсли;
            
        КонецЕсли;
        
        // ==================================================
        // 3. ВЫВОДИМ ИТОГИ (если есть область "Итоги")
        // ==================================================
        ОбластьИтоги = Макет.ПолучитьОбласть("Итоги");
        Если ОбластьИтоги <> Неопределено Тогда
            ОбластьИтоги.Параметры.ОбщаяСумма = ТекущийДокумент.СуммаПродажи;
            ТабДок.Вывести(ОбластьИтоги);
        КонецЕсли;
        
        // Разделитель страниц между документами (если их несколько)
        Если МассивОбъектов.Индекс(ТекущийДокумент) < МассивОбъектов.Количество() - 1 Тогда
            ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;
        
    КонецЦикла;
    
    Возврат ТабДок;
    
КонецФункции