Процедура ОбработкаПроведения(Отказ, Режим)

  // регистр ОстаткиПродукции Расход
  Движения.ОстаткиПродукции.Записывать = Истина;

  Для Каждого ТекСтрокаЗаказ Из Заказ Цикл

    // Проверка остатка
    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ
    |  ОстаткиИОбороты.Продукция КАК Продукция,
    |  ОстаткиИОбороты.КоличествоНачальныйОстаток КАК НачальныйОстаток,
    |  ОстаткиИОбороты.КоличествоПриход КАК Приход,
    |  ОстаткиИОбороты.КоличествоРасход КАК Расход,
    |  ОстаткиИОбороты.КоличествоКонечныйОстаток КАК КонечныйОстаток
    |ИЗ
    |  РегистрНакопления.ОстаткиПродукции.ОстаткиИОбороты(
    |    &НачДата,
    |    &КонДата,
    |    ,
    |    ,
    |  ) КАК ОстаткиИОбороты";

    Запрос.УстановитьПараметр("НачДата", '00010101');
    Запрос.УстановитьПараметр("КонДата", ТекущаяДата());

    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();

    Если Выборка.Следующий() Тогда

      Если Выборка.КонечныйОстаток < ТекСтрокаЗаказ.Количество Тогда

        Сообщить(
        "Недостаточно продукции на складе: "
        + ТекСтрокаЗаказ.Продукция);

        Отказ = Истина;
        Возврат;

      КонецЕсли;

    Иначе

      Сообщить(
      "Продукция отсутствует на складе: "
      + ТекСтрокаЗаказ.Продукция);

      Отказ = Истина;
      Возврат;

    КонецЕсли;

    // Движение расхода
    Движение = Движения.ОстаткиПродукции.Добавить();

    Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
    Движение.Период = Дата;

    Движение.Продукция = ТекСтрокаЗаказ.Продукция;
    Движение.Количество = ТекСтрокаЗаказ.Количество;

  КонецЦикла;

КонецПроцедуры