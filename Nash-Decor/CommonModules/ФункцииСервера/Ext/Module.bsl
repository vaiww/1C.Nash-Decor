Функция РасчетСкидкиПартнера(ОбъемПродаж) Экспорт
	
	Если ОбъемПродаж < 10000 Тогда
		ВеличинаСкидки = 0;
	КонецЕсли;
	
	Если ОбъемПродаж >= 10000 И ОбъемПродаж < 50000 Тогда
		ВеличинаСкидки = 5;
	КонецЕсли;
	
	Если ОбъемПродаж >= 50000 И ОбъемПродаж < 300000 Тогда
		ВеличинаСкидки = 10;
	КонецЕсли;

	Если ОбъемПродаж >= 300000 Тогда
		ВеличинаСкидки = 15;
	КонецЕсли;
	
	Возврат ВеличинаСкидки;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеМатериалов(ПродукцияСсылка, КоличествоПроизведеннойПродукции) Экспорт
	МассивДанных = Новый Массив;		
	// Формируем запрос для получения материалов и необходимого количества с учетом произведенного объема продукции
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    МатериалыВПродукции.Материал КАК Материал,
	|    МатериалыВПродукции.НеобходимоеКоличествоМатериала * &КоличествоПродукции КАК КоличествоЗатраченногоМатериала
	|ИЗ
	|    Справочник.Продукция.МатериалыВПродукции КАК МатериалыВПродукции
	|ГДЕ
	|    МатериалыВПродукции.Ссылка = &ПродукцияСсылка";		
	// Устанавливаем параметры запроса
	Запрос.УстановитьПараметр("ПродукцияСсылка", ПродукцияСсылка);
	Запрос.УстановитьПараметр("КоличествоПродукции", КоличествоПроизведеннойПродукции);		
	// Выполняем запрос
	РезультатЗапроса = Запрос.Выполнить();		
	// Если данных нет, возвращаем пустой массив
	Если РезультатЗапроса.Пустой() Тогда
		Возврат МассивДанных;
	КонецЕсли;		
	// Проходим по выборке результатов запроса
	Выборка = РезультатЗапроса.Выбрать();	
	Пока Выборка.Следующий() Цикл	
		// Формируем структуру с данными по материалу и количеству
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("Материал", Выборка.Материал);
		СтрокаДанных.Вставить("КоличествоЗатраченногоМатериала", Выборка.КоличествоЗатраченногоМатериала);		
		// Добавляем структуру в массив результатов
		МассивДанных.Добавить(СтрокаДанных);		
	КонецЦикла;	
	// Возвращаем массив с данными по материалам
	Возврат МассивДанных;	
КонецФункции
